{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "types": ["cypress", "node"]
  },
  "include": [
    "../node_modules/cypress",
    "./**/*.ts",
    "cypress/**/*.d.ts",
    "cypress/**/*.ts"
  ]
}
